/* Skill Guide Book (KAN-64). Same palette as MainMenu.uss (its :root variables, .ss-hidden apply here too: this tree is
   instanced inside MainMenu.uxml). Reference 1080x1920 portrait, match width. Tier colours match the in-game skill cards
   (GameHud.uss skill-card--*): Common worn steel, Rare soul blue, Epic violet, Legendary ember gold.
   Open / close: SkillGuideScreen toggles sg-screen--closed; the transition fades and slides (like HeroSelect.uss). */

.sg-screen {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgb(9, 11, 17); /* opaque: the menu title must not show through */
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-cubic;
}

.sg-screen--closed {
    opacity: 0;
    translate: 0 60px;
}

.sg-safe {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
}

/* ---------- Header ---------- */

.sg-header {
    width: 940px;
    margin-top: 56px;
    margin-bottom: 8px;
    flex-direction: column;
    align-items: center;
}

.sg-header__bar {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.unity-button.sg-back {
    height: 96px;
    min-width: 220px;
    margin: 0;
    padding: 0 30px;
    font-size: 34px;
    letter-spacing: 8px;
    -unity-font-style: bold;
    color: var(--ss-ash);
    background-color: rgba(20, 22, 30, 0.7);
    background-image: none;
    border-width: 2px;
    border-color: rgba(232, 196, 120, 0.22);
    border-radius: 4px;
}

.unity-button.sg-back:active {
    scale: 0.96 0.96;
}

.sg-count {
    font-size: 26px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    color: var(--ss-ash-dim);
}

.sg-title {
    font-size: 62px;
    letter-spacing: 14px;
    padding-left: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--ss-gold);
    margin: 0;
    text-shadow: 0 4px 12px rgba(0, 0, 0, 0.85);
}

.sg-subtitle {
    margin-top: 10px;
    font-size: 30px;
    -unity-text-align: middle-center;
    -unity-font-style: italic;
    color: var(--ss-ash-dim);
}

/* ---------- List page ---------- */

.sg-list-page {
    flex-grow: 1;
    width: 100%;
    flex-direction: column;
    align-items: center;
}

.sg-chips {
    width: 960px;
    flex-direction: row;
    justify-content: center;
    margin-top: 12px;
}

.unity-button.sg-chip {
    height: 70px;
    min-width: 150px;
    margin: 0 6px;
    padding: 0 18px;
    font-size: 24px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: var(--ss-ash-dim);
    background-color: rgba(20, 22, 30, 0.8);
    background-image: none;
    border-width: 2px;
    border-color: rgba(232, 196, 120, 0.18);
    border-radius: 35px;
    transition-property: background-color, border-color, color, scale;
    transition-duration: 0.12s;
}

.unity-button.sg-chip:active {
    scale: 0.95 0.95;
}

.unity-button.sg-chip--on {
    color: rgb(30, 22, 10);
    background-color: var(--ss-gold);
    border-color: var(--ss-gold-bright);
}

.sg-list {
    flex-grow: 1;
    width: 100%;
    margin-top: 14px;
}

.sg-list .unity-scroll-view__content-container {
    align-items: center;
    padding-top: 10px;
    padding-bottom: 80px;
}

.sg-grid {
    width: 960px;
    flex-direction: row;
    flex-wrap: wrap;
}

.unity-button.sg-card {
    width: 456px;
    height: 330px;
    margin: 0 12px 24px 12px;
    padding: 18px 20px;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    background-color: rgba(20, 22, 30, 0.92);
    background-image: none;
    border-width: 3px;
    border-color: var(--sg-rim);
    border-radius: 14px;
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

.unity-button.sg-card:active {
    scale: 0.97 0.97;
    background-color: rgba(40, 32, 20, 0.95);
}

.sg-card__top {
    flex-direction: row;
    align-items: center;
}

.sg-icon {
    width: 116px;
    height: 116px;
    flex-shrink: 0;
    border-radius: 58px;
    border-width: 3px;
    border-color: var(--sg-rim);
    background-color: rgba(0, 0, 0, 0.45);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--sg-glow);
}

.sg-card__head {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 18px;
    flex-direction: column;
}

.sg-card__name {
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--sg-glow);
    margin: 0;
    white-space: normal;
}

.sg-card__tier {
    margin-top: 4px;
    font-size: 22px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    color: var(--sg-rim);
}

.sg-card__desc {
    margin-top: 14px;
    flex-grow: 1;
    font-size: 26px;
    color: var(--ss-ash);
    white-space: normal;
    -unity-text-align: upper-left;
}

.sg-card__foot {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.sg-card__kind {
    font-size: 20px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: var(--ss-ash-dim);
}

.sg-card__max {
    font-size: 22px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: var(--ss-gold);
}

.sg-pips {
    flex-direction: row;
    margin-top: 8px;
}

.sg-pip {
    width: 16px;
    height: 16px;
    margin-right: 10px;
    rotate: 45deg;
    border-radius: 3px;
    background-color: var(--sg-rim);
}

/* Not yet found (only with the "hide unfound" option): dark glyph, "???". */
.sg-card--unknown .sg-icon {
    -unity-background-image-tint-color: rgb(0, 0, 0);
}

.sg-card--unknown .sg-card__name,
.sg-card--unknown .sg-card__desc {
    color: var(--ss-ash-dim);
}

.sg-empty {
    margin-top: 60px;
    font-size: 30px;
    -unity-font-style: italic;
    color: var(--ss-ash-dim);
}

/* ---------- Tiers (code always sets one on each card and on the detail page) ---------- */

.sg-tier--common { --sg-rim: rgb(150, 146, 138); --sg-glow: rgb(222, 216, 204); }
.sg-tier--rare { --sg-rim: rgb(86, 150, 236); --sg-glow: rgb(170, 214, 255); }
.sg-tier--epic { --sg-rim: rgb(166, 96, 236); --sg-glow: rgb(222, 186, 255); }
.sg-tier--legendary { --sg-rim: rgb(244, 172, 48); --sg-glow: rgb(255, 224, 140); }

/* ---------- Detail page ---------- */

.sg-detail {
    flex-grow: 1;
    width: 960px;
    flex-direction: column;
    align-items: center;
}

.sg-detail__head {
    margin-top: 16px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.sg-detail__icon {
    width: 220px;
    height: 220px;
    margin: 0 50px;
    border-radius: 110px;
    border-width: 4px;
    border-color: var(--sg-rim);
    background-color: rgba(0, 0, 0, 0.45);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--sg-glow);
}

.unity-button.sg-arrow {
    width: 110px;
    height: 110px;
    margin: 0;
    font-size: 48px;
    -unity-font-style: bold;
    color: var(--ss-gold);
    background-color: rgba(20, 22, 30, 0.8);
    background-image: none;
    border-width: 2px;
    border-color: rgba(232, 196, 120, 0.3);
    border-radius: 55px;
}

.unity-button.sg-arrow:active {
    scale: 0.92 0.92;
}

.sg-detail__name {
    margin-top: 18px;
    font-size: 52px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--sg-glow);
}

.sg-detail__tags {
    margin-top: 10px;
    flex-direction: row;
    justify-content: center;
}

.sg-tag {
    margin: 0 8px;
    padding: 4px 16px;
    font-size: 22px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: var(--ss-ash);
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 4px;
}

.sg-tag--tier {
    color: rgb(16, 14, 12);
    background-color: var(--sg-rim);
}

.sg-detail__desc {
    margin-top: 16px;
    font-size: 30px;
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    color: var(--ss-ash);
    white-space: normal;
}

.sg-detail__scroll {
    flex-grow: 1;
    width: 100%;
    margin-top: 14px;
}

.sg-detail__scroll .unity-scroll-view__content-container {
    padding-bottom: 60px;
}

.sg-section {
    margin-top: 22px;
    margin-bottom: 10px;
    font-size: 26px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    color: var(--ss-gold);
}

.sg-para {
    font-size: 28px;
    color: var(--ss-ash);
    white-space: normal;
}

.sg-rows {
    flex-direction: column;
}

.sg-row {
    flex-direction: row;
    align-items: flex-start;
    padding: 12px 14px;
    margin-bottom: 8px;
    background-color: rgba(20, 22, 30, 0.85);
    border-left-width: 4px;
    border-color: var(--sg-rim);
    border-radius: 6px;
}

.sg-row__level {
    width: 96px;
    flex-shrink: 0;
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--sg-glow);
}

.sg-row__body {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
}

.sg-row__text {
    font-size: 28px;
    color: var(--ss-ash);
    white-space: normal;
}

.sg-effects {
    margin-top: 6px;
    flex-direction: row;
    flex-wrap: wrap;
}

.sg-effect {
    flex-direction: row;
    margin: 4px 10px 0 0;
    padding: 2px 10px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
}

.sg-effect__label {
    font-size: 22px;
    color: var(--ss-ash-dim);
}

.sg-effect__value {
    margin-left: 8px;
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--ss-ash);
}

/* The number changed from the level before. */
.sg-effect--changed {
    background-color: rgba(232, 196, 120, 0.16);
}

.sg-effect--changed .sg-effect__value {
    color: var(--ss-gold-bright);
}

.sg-pos {
    margin-top: 6px;
    margin-bottom: 30px;
    font-size: 24px;
    letter-spacing: 4px;
    color: var(--ss-ash-dim);
}
