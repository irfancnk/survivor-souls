<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="GameHud.uss" />
    <!-- Red screen-edge flash on damage (PlayerHealthHud). Texture and opacity set in code. Never blocks touches. -->
    <ui:VisualElement name="damage-vignette" class="hud-vignette" picking-mode="Ignore" />

    <!-- Floating joystick (JoystickView): size, position and opacities set in code. Idle at the bottom centre, jumps to the
         touch point; only the chevron(s) of the drag direction stay visible. Never blocks touches. -->
    <ui:VisualElement name="joystick" class="hud-joystick" picking-mode="Ignore">
        <ui:VisualElement name="joystick-ring" class="hud-joystick__ring" picking-mode="Ignore" />
        <ui:VisualElement name="joystick-side-up" class="hud-joystick__side" picking-mode="Ignore">
            <ui:VisualElement class="hud-joystick__chevron" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="joystick-side-right" class="hud-joystick__side hud-joystick__side--right" picking-mode="Ignore">
            <ui:VisualElement class="hud-joystick__chevron" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="joystick-side-down" class="hud-joystick__side hud-joystick__side--down" picking-mode="Ignore">
            <ui:VisualElement class="hud-joystick__chevron" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="joystick-side-left" class="hud-joystick__side hud-joystick__side--left" picking-mode="Ignore">
            <ui:VisualElement class="hud-joystick__chevron" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="joystick-knob" class="hud-joystick__knob" picking-mode="Ignore" />
    </ui:VisualElement>

    <ui:VisualElement name="safe-root" class="hud-root" picking-mode="Ignore">
        <!-- Run XP (XpHud, KAN-21): level number + soul-blue bar, fill width set in code. -->
        <ui:VisualElement name="xp" class="hud-xp" picking-mode="Ignore">
            <ui:Label name="xp-level" text="LV 1" class="hud-xp__level" picking-mode="Ignore" />
            <ui:VisualElement class="hud-xp__track" picking-mode="Ignore">
                <ui:VisualElement name="xp-fill" class="hud-xp__fill" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Chamber survival countdown (TimerHud, KAN-39). Hidden in boss Chambers. -->
        <ui:VisualElement name="timer" class="hud-timer" picking-mode="Ignore">
            <ui:Label name="timer-label" text="10:00" class="hud-timer__label" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- Boss health (BossHud, KAN-58): name, bar, title. Boss Chambers only, in the timer's place, once the boss rises. -->
        <ui:VisualElement name="boss" class="hud-boss hud-hidden" picking-mode="Ignore">
            <ui:Label name="boss-name" text="" class="hud-boss__name" picking-mode="Ignore" />
            <ui:VisualElement class="hud-boss__track" picking-mode="Ignore">
                <ui:VisualElement name="boss-trail" class="hud-boss__trail" picking-mode="Ignore" />
                <ui:VisualElement name="boss-fill" class="hud-boss__fill" picking-mode="Ignore" />
                <!-- Phase 2 mark (KAN-61): tick at the phase 2 health share, lights when phase 2 starts. -->
                <ui:VisualElement name="boss-phase" class="hud-boss__phase" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="boss-title" text="" class="hud-boss__title" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="hud-top" picking-mode="Ignore">
            <ui:Button name="btn-pause" text="II" class="hud-button" />
            <!-- Player health (PlayerHealthHud): trail drains behind the fill. -->
            <ui:VisualElement name="player-hp" class="hud-hp" picking-mode="Ignore">
                <ui:VisualElement class="hud-hp__track" picking-mode="Ignore">
                    <ui:VisualElement name="player-hp-trail" class="hud-hp__trail" picking-mode="Ignore" />
                    <ui:VisualElement name="player-hp-fill" class="hud-hp__fill" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="player-hp-value" text="" class="hud-hp__value" picking-mode="Ignore" />
            </ui:VisualElement>
            <!-- Souls this run (SoulCounterHud, KAN-96): soul gem + number, pops when it rises. -->
            <ui:VisualElement name="run-souls" class="hud-souls" picking-mode="Ignore">
                <ui:VisualElement class="hud-souls__gem" picking-mode="Ignore" />
                <ui:Label name="run-souls-value" text="0" class="hud-souls__value" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Owned skills (SkillHud, KAN-19): icon slots added in code, pick order. -->
        <ui:VisualElement name="skill-row" class="hud-skills" picking-mode="Ignore" />
        <ui:VisualElement class="hud-spacer" picking-mode="Ignore" />
        <ui:Label name="lbl-hint" text="Drag anywhere to move" class="hud-hint" picking-mode="Ignore" />
        <!-- Timer toasts: "5 MINUTES REMAIN", "THE PORTAL IS OPEN" (TimerHud). Opacity and scale set in code. -->
        <ui:Label name="chamber-toast" text="" class="chamber-toast hud-hidden" picking-mode="Ignore" />
        <!-- Boss banner (BossBannerHud, KAN-62): dark band with the boss name during the intro, "GREAT FOE FELLED" after the
             kill. Opacity and text scale set in code. -->
        <ui:VisualElement name="boss-banner" class="boss-banner hud-hidden" picking-mode="Ignore">
            <ui:Label name="boss-banner-text" text="" class="boss-banner__text" picking-mode="Ignore" />
            <ui:VisualElement class="boss-banner__rule" picking-mode="Ignore" />
            <ui:Label name="boss-banner-sub" text="" class="boss-banner__sub" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Small bar over the Knight, placed in code at a world point. -->
    <ui:VisualElement name="player-overhead" class="hud-overhead" picking-mode="Ignore">
        <ui:VisualElement name="player-overhead-fill" class="hud-overhead__fill" picking-mode="Ignore" />
    </ui:VisualElement>

    <!-- "LEVEL UP" over the Knight (XpHud), placed in code at a world point. -->
    <ui:Label name="levelup-pop" text="LEVEL UP" class="levelup-pop hud-hidden" picking-mode="Ignore" />

    <!-- Level-up skill pick (SkillChoiceScreen, KAN-19). Game is paused while shown. hud-modal: a press here never starts
         the joystick. Cards filled and animated in code; card count/order = SkillChoiceScreen.MaxCards.
         Tier (KAN-37): sheen/shine = Legendary light sweep, marks = tier gems, burst = ring + sparks when the card lands. -->
    <ui:VisualElement name="skill-choice" class="skills hud-modal hud-hidden">
        <ui:VisualElement class="skills__band" picking-mode="Ignore">
            <ui:Label name="skill-choice-title" text="LEVEL 2" class="skills__title" picking-mode="Ignore" />
            <ui:Label name="skill-choice-sub" text="CHOOSE AN EMBER BOON" class="skills__sub" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="skills__cards" picking-mode="Ignore">
            <ui:Button name="skill-card-0" class="skill-card">
                <ui:VisualElement class="skill-card__sheen" picking-mode="Ignore">
                    <ui:VisualElement class="skill-card__shine" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label text="COMMON" class="skill-card__rarity" picking-mode="Ignore" />
                <ui:VisualElement class="skill-card__marks" picking-mode="Ignore" />
                <ui:VisualElement class="skill-card__plate" picking-mode="Ignore">
                    <ui:VisualElement class="skill-card__burst" picking-mode="Ignore" />
                    <ui:VisualElement class="skill-card__icon" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label text="SKILL" class="skill-card__name" picking-mode="Ignore" />
                <ui:Label text="" class="skill-card__desc" picking-mode="Ignore" />
                <ui:VisualElement class="hud-spacer" picking-mode="Ignore" />
                <ui:VisualElement class="skill-card__pips" picking-mode="Ignore" />
                <ui:Label text="NEW" class="skill-card__badge" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="skill-card-1" class="skill-card">
                <ui:VisualElement class="skill-card__sheen" picking-mode="Ignore">
                    <ui:VisualElement class="skill-card__shine" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label text="COMMON" class="skill-card__rarity" picking-mode="Ignore" />
                <ui:VisualElement class="skill-card__marks" picking-mode="Ignore" />
                <ui:VisualElement class="skill-card__plate" picking-mode="Ignore">
                    <ui:VisualElement class="skill-card__burst" picking-mode="Ignore" />
                    <ui:VisualElement class="skill-card__icon" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label text="SKILL" class="skill-card__name" picking-mode="Ignore" />
                <ui:Label text="" class="skill-card__desc" picking-mode="Ignore" />
                <ui:VisualElement class="hud-spacer" picking-mode="Ignore" />
                <ui:VisualElement class="skill-card__pips" picking-mode="Ignore" />
                <ui:Label text="NEW" class="skill-card__badge" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="skill-card-2" class="skill-card">
                <ui:VisualElement class="skill-card__sheen" picking-mode="Ignore">
                    <ui:VisualElement class="skill-card__shine" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label text="COMMON" class="skill-card__rarity" picking-mode="Ignore" />
                <ui:VisualElement class="skill-card__marks" picking-mode="Ignore" />
                <ui:VisualElement class="skill-card__plate" picking-mode="Ignore">
                    <ui:VisualElement class="skill-card__burst" picking-mode="Ignore" />
                    <ui:VisualElement class="skill-card__icon" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label text="SKILL" class="skill-card__name" picking-mode="Ignore" />
                <ui:Label text="" class="skill-card__desc" picking-mode="Ignore" />
                <ui:VisualElement class="hud-spacer" picking-mode="Ignore" />
                <ui:VisualElement class="skill-card__pips" picking-mode="Ignore" />
                <ui:Label text="NEW" class="skill-card__badge" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Death screen: hidden until PlayerDeath.Finished, then fades in. -->
    <ui:VisualElement name="death-screen" class="death hud-hidden">
        <ui:VisualElement class="death__band" picking-mode="Ignore">
            <ui:Label text="YOU DIED" class="death__title" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- Run counters (KAN-51): filled by PlayerHealthHud when the screen opens. -->
        <ui:VisualElement class="death__stats" picking-mode="Ignore">
            <ui:VisualElement class="death__stat" picking-mode="Ignore">
                <ui:Label name="death-souls" text="0" class="death__stat-value" picking-mode="Ignore" />
                <ui:Label text="SOULS" class="death__stat-label" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="death__stat-rule" picking-mode="Ignore" />
            <ui:VisualElement class="death__stat" picking-mode="Ignore">
                <ui:Label name="death-kills" text="0" class="death__stat-value" picking-mode="Ignore" />
                <ui:Label text="KILLS" class="death__stat-label" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="death__stat-rule" picking-mode="Ignore" />
            <ui:VisualElement class="death__stat" picking-mode="Ignore">
                <ui:Label name="death-chamber" text="I" class="death__stat-value" picking-mode="Ignore" />
                <ui:Label text="CHAMBER" class="death__stat-label" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Run souls banked + wallet balance (PlayerHealthHud, KAN-96). -->
        <ui:Label name="death-wallet" text="" class="death__wallet" picking-mode="Ignore" />
        <ui:VisualElement class="death__buttons" picking-mode="Ignore">
            <ui:Button name="btn-retry" text="RETRY" class="death__button death__button--primary" />
            <ui:Button name="btn-menu" text="MENU" class="death__button" />
        </ui:VisualElement>
    </ui:VisualElement>
    <!-- Portal transition (ChamberTransitionHud, KAN-40): "CHAMBER N" title card, then the full-screen white fade on top
         of everything. Opacity and position set in code. Never block touches (input is locked during the fade). -->
    <ui:VisualElement name="chamber-card" class="chamber-card hud-hidden" picking-mode="Ignore">
        <ui:Label name="chamber-card-title" text="CHAMBER II" class="chamber-card__title" picking-mode="Ignore" />
        <ui:VisualElement class="chamber-card__rule" picking-mode="Ignore" />
        <ui:Label name="chamber-card-sub" text="REALM I" class="chamber-card__sub" picking-mode="Ignore" />
    </ui:VisualElement>
    <ui:VisualElement name="transition-fade" class="transition-fade hud-hidden" picking-mode="Ignore" />
    <!-- End of Realm victory screen (RealmVictoryHud, KAN-47): over the white fade, opens after the last Chamber's portal.
         Texts and counters set in code. -->
    <ui:VisualElement name="victory-screen" class="victory hud-hidden">
        <ui:VisualElement class="victory__band" picking-mode="Ignore">
            <ui:Label text="REALM CLEARED" class="victory__title" picking-mode="Ignore" />
            <ui:VisualElement class="victory__rule" picking-mode="Ignore" />
            <ui:Label name="victory-realm" text="REALM I" class="victory__realm" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="victory__stats" picking-mode="Ignore">
            <ui:VisualElement class="death__stat" picking-mode="Ignore">
                <ui:Label name="victory-souls" text="0" class="death__stat-value" picking-mode="Ignore" />
                <ui:Label text="SOULS" class="death__stat-label" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="death__stat-rule" picking-mode="Ignore" />
            <ui:VisualElement class="death__stat" picking-mode="Ignore">
                <ui:Label name="victory-kills" text="0" class="death__stat-value" picking-mode="Ignore" />
                <ui:Label text="KILLS" class="death__stat-label" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="death__stat-rule" picking-mode="Ignore" />
            <ui:VisualElement class="death__stat" picking-mode="Ignore">
                <ui:Label name="victory-level" text="1" class="death__stat-value" picking-mode="Ignore" />
                <ui:Label text="LEVEL" class="death__stat-label" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Run souls banked + wallet balance (RealmVictoryHud, KAN-96). -->
        <ui:Label name="victory-wallet" text="" class="death__wallet" picking-mode="Ignore" />
        <ui:Label name="victory-unlock" text="REALM II UNLOCKED" class="victory__unlock" picking-mode="Ignore" />
        <ui:VisualElement class="death__buttons" picking-mode="Ignore">
            <ui:Button name="btn-victory-continue" text="CONTINUE" class="death__button death__button--primary victory__button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
