/* In-game HUD. Reference 1080x1920, match width (see GameHudPanelSettings). Sizes in px. */

:root {
    --hud-gold: rgb(232, 196, 120);
    --hud-ash: rgba(206, 200, 188, 0.75);
    --hud-ring: rgba(232, 196, 120, 0.35);
    --hud-ring-fill: rgba(10, 12, 18, 0.28);
    --hud-knob: rgba(232, 196, 120, 0.55);
    --hud-chevron: rgba(244, 214, 150, 0.95);
    --hud-panel: rgba(16, 18, 26, 0.7);
    --hud-hp-fill: rgb(116, 178, 74);
    --hud-hp-trail: rgb(236, 196, 104);
    --hud-hp-track: rgba(8, 8, 10, 0.72);
    --hud-death-red: rgb(158, 24, 18);
    --hud-soul: rgb(156, 210, 255);
    --hud-soul-glow: rgb(226, 244, 255);
}

.hud-hidden {
    display: none;
}

.hud-root {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    flex-direction: column;
}

.hud-top {
    flex-direction: row;
    align-items: center;
    padding: 22px 40px 0 40px;
}

.hud-spacer {
    flex-grow: 1;
}

.hud-button {
    width: 120px;
    height: 120px;
    border-radius: 60px;
    border-width: 3px;
    border-color: var(--hud-ring);
    background-color: var(--hud-panel);
    color: var(--hud-gold);
    font-size: 44px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.hud-button:active {
    background-color: rgba(60, 46, 28, 0.85);
}

.hud-hint {
    align-self: center;
    margin-bottom: 480px; /* above the idle joystick (JoystickView.idleBottomMargin + ring + chevron) */
    font-size: 40px;
    color: var(--hud-ash);
    -unity-text-align: middle-center;
    transition-property: opacity;
    transition-duration: 0.6s;
}

.hud-hint--gone {
    opacity: 0;
}

/* Joystick (JoystickView, KAN-16): size, translate and opacities set in code; these are the looks.
   Transparent on purpose: the stick sits over the world. Chevron = square with two borders, turned 45 deg. */
.hud-joystick {
    position: absolute;
    left: 0;
    top: 0;
    width: 240px;
    height: 240px;
}

.hud-joystick__ring {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    border-width: 3px;
    border-color: var(--hud-ring);
    background-color: var(--hud-ring-fill);
    border-radius: 120px;
}

.hud-joystick__side {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

.hud-joystick__side--right { rotate: 90deg; }
.hud-joystick__side--down { rotate: 180deg; }
.hud-joystick__side--left { rotate: 270deg; }

.hud-joystick__chevron {
    position: absolute;
    left: 50%;
    top: -20%; /* just outside the ring: the knob at full drag never hides the active chevron */
    width: 46px;
    height: 46px;
    margin-left: -23px;
    border-top-width: 8px;
    border-left-width: 8px;
    border-color: var(--hud-chevron);
    border-top-left-radius: 4px;
    rotate: 45deg;
}

.hud-joystick__knob {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 72px;
    height: 72px;
    margin-left: -36px;
    margin-top: -36px;
    border-radius: 36px;
    background-color: var(--hud-knob);
    border-width: 2px;
    border-color: rgba(255, 236, 190, 0.7);
    opacity: 0;
}

/* Combat (CombatHud): placed in code with translate at a world point; margins centre each element on it. */
.combat-layer {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    overflow: hidden;
}

.combat-bar {
    position: absolute;
    left: 0; top: 0;
    width: 96px;
    height: 8px;
    margin-left: -48px;
    margin-top: -4px;
    background-color: rgba(8, 6, 6, 0.7);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.9);
    border-radius: 2px;
    overflow: hidden;
}

.combat-bar__fill {
    height: 100%;
    width: 100%;
    background-color: rgb(196, 38, 34);
}

.combat-number {
    position: absolute;
    left: 0; top: 0;
    width: 200px;
    height: 60px;
    margin-left: -100px;
    margin-top: -30px;
    padding: 0;
    font-size: 46px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 236, 190);
    -unity-text-outline-width: 3px; /* reads on white snow too */
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
}

.combat-number--kill {
    color: rgb(255, 92, 72);
    font-size: 54px;
}

/* Hit / kill marker (HitMarkerHud, KAN-13). Zero-size marker placed with translate; arms rotated in code
   (45/135/225/315 deg) about their own point; each tick sits above its arm, past the centre gap.
   Gap = -top - height. Dark border keeps white ticks readable on pale sand plazas. */
.hit-marker-layer {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    overflow: hidden;
}

.hit-marker {
    position: absolute;
    left: 0; top: 0;
    width: 0;
    height: 0;
}

.hit-marker__arm {
    position: absolute;
    left: 0; top: 0;
    width: 0;
    height: 0;
}

.hit-marker__tick {
    position: absolute;
    width: 9px;
    height: 30px;
    left: -4.5px;
    top: -54px; /* gap 24 px */
    border-radius: 3px;
    border-width: 1.5px;
    border-color: rgba(0, 0, 0, 0.55);
    background-color: rgb(255, 255, 255);
}

.hit-marker--kill .hit-marker__tick {
    width: 12px;
    height: 42px;
    left: -6px;
    top: -72px; /* gap 30 px */
    border-color: rgba(30, 0, 0, 0.6);
    background-color: rgb(236, 44, 34);
}

/* Player health (PlayerHealthHud). Fill/trail widths set in code (percent). Green = the player; red = enemies. */
.hud-hp {
    flex-grow: 1;
    max-width: 640px;
    margin-left: 32px;
    flex-direction: row;
    align-items: center;
}

.hud-hp__track {
    flex-grow: 1;
    height: 34px;
    background-color: var(--hud-hp-track);
    border-width: 3px;
    border-color: rgba(232, 196, 120, 0.45);
    border-radius: 4px;
    overflow: hidden;
}

.hud-hp__trail,
.hud-hp__fill {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 100%;
}

.hud-hp__trail {
    background-color: var(--hud-hp-trail);
}

.hud-hp__fill {
    background-color: var(--hud-hp-fill);
    border-right-width: 2px;
    border-color: rgba(220, 255, 190, 0.5);
}

.hud-hp__value {
    min-width: 110px;
    margin-left: 16px;
    padding: 0;
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: var(--hud-gold);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
}

/* Souls this run (SoulCounterHud, KAN-96): right of the health bar. Scale set in code (pop on pickup). */
.hud-souls {
    flex-direction: row;
    align-items: center;
    margin-left: 18px;
    padding: 6px 22px 6px 16px;
    border-radius: 30px;
    border-width: 2px;
    border-color: rgba(156, 210, 255, 0.4);
    background-color: rgba(8, 10, 16, 0.62);
}

.hud-souls__gem {
    width: 30px;
    height: 30px;
    rotate: 45deg;
    border-radius: 6px;
    border-width: 2px;
    border-color: var(--hud-soul-glow);
    background-color: var(--hud-soul);
}

.hud-souls__value {
    min-width: 70px;
    margin: 0 0 0 16px;
    padding: 0;
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: var(--hud-soul-glow);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
}

.hud-overhead {
    position: absolute;
    left: 0; top: 0;
    width: 120px;
    height: 12px;
    margin-left: -60px;
    margin-top: -6px;
    background-color: var(--hud-hp-track);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.9);
    border-radius: 3px;
    overflow: hidden;
}

.hud-overhead__fill {
    height: 100%;
    width: 100%;
    background-color: var(--hud-hp-fill);
}

/* Damage vignette: full-screen generated texture, stretched (ellipse follows the screen shape). */
.hud-vignette {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    opacity: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

/* Death screen (Souls style): dark veil, black band, big red title, two buttons. */
.death {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    justify-content: center;
    align-items: stretch;
    background-color: rgba(0, 0, 0, 0.45);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 1.2s;
    transition-timing-function: ease-in-sine;
}

.death--shown {
    opacity: 1;
}

.death__band {
    padding: 70px 0;
    background-color: rgba(0, 0, 0, 0.72);
    align-items: center;
}

.death__title {
    font-size: 132px;
    letter-spacing: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--hud-death-red);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(30, 0, 0, 0.9);
    padding: 0;
    margin: 0;
}

.death__stats {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 30px 0 34px 0;
    background-color: rgba(0, 0, 0, 0.58); /* joins the band: numbers read on bright snow */
    border-top-width: 1px;
    border-color: rgba(232, 196, 120, 0.22);
}

.death__stat {
    width: 250px;
    align-items: center;
}

.death__stat-value {
    font-size: 72px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 228, 170);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
    padding: 0;
    margin: 0;
}

.death__stat-label {
    margin-top: 6px;
    padding: 0;
    font-size: 30px;
    letter-spacing: 8px;
    -unity-text-align: middle-center;
    color: rgb(206, 198, 182);
}

.death__stat-rule {
    width: 2px;
    height: 96px;
    background-color: rgba(232, 196, 120, 0.3);
}

/* Banked souls + wallet balance under the run counters (KAN-96). */
.death__wallet {
    margin-top: 28px;
    padding: 14px 36px;
    align-self: center;
    font-size: 34px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--hud-soul-glow);
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 6px;
}

.death__buttons {
    flex-direction: row;
    justify-content: center;
    margin-top: 80px;
}

.unity-button.death__button {
    width: 340px;
    height: 132px;
    margin: 0 22px;
    padding: 0;
    font-size: 46px;
    letter-spacing: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(206, 200, 188);
    background-color: rgba(20, 22, 30, 0.85);
    background-image: none;
    border-width: 2px;
    border-color: rgba(232, 196, 120, 0.3);
    border-radius: 4px;
}

.unity-button.death__button--primary {
    color: rgb(255, 228, 170);
    background-color: rgba(150, 70, 28, 0.88);
    border-color: var(--hud-gold);
}

.unity-button.death__button:active {
    scale: 0.97 0.97;
}

/* Run XP (XpHud, KAN-21): full-width thin bar at the very top, soul blue (green = health, red = enemies). */
.hud-xp {
    flex-direction: row;
    align-items: center;
    padding: 28px 40px 0 40px;
}

.hud-xp__level {
    min-width: 120px;
    padding: 0;
    margin: 0 16px 0 0;
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: var(--hud-soul-glow);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
}

.hud-xp__track {
    flex-grow: 1;
    height: 20px;
    background-color: var(--hud-hp-track);
    border-width: 2px;
    border-color: rgba(156, 210, 255, 0.4);
    border-radius: 10px;
    overflow: hidden;
}

.hud-xp__fill {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 0;
    background-color: var(--hud-soul);
    border-right-width: 2px;
    border-color: var(--hud-soul-glow);
}

.hud-xp--flash {
    border-color: var(--hud-soul-glow);
    background-color: rgba(120, 170, 220, 0.6);
}

/* "LEVEL UP" over the Knight. Translate, scale and opacity set in code (unscaled time). */
.levelup-pop {
    position: absolute;
    left: 0; top: 0;
    width: 400px;
    margin-left: -200px;
    margin-top: -40px;
    padding: 0;
    font-size: 64px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--hud-soul-glow);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgba(10, 30, 60, 0.95);
}

/* Level-up skill pick (SkillChoiceScreen, KAN-19): veil, header band, three rune cards. Opacity, translate and scale of the
   screen and cards are set in code. Tier (KAN-37): common = worn steel, rare = soul blue, epic = violet,
   legendary = ember gold. Each tier also has its name and 1-4 gems (marks), so it reads without colour. */
.skills {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    justify-content: center;
    padding: 0 30px 160px 30px;
    background-color: rgba(4, 8, 14, 0.62);
}

.skills__band {
    flex-shrink: 0;
    padding: 34px 0 30px 0;
    margin: 0 -30px 56px -30px;
    background-color: rgba(4, 8, 16, 0.8);
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-color: rgba(232, 196, 120, 0.45);
    align-items: center;
}

.skills__title {
    font-size: 104px;
    letter-spacing: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--hud-soul-glow);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(20, 60, 110, 0.9);
    padding: 0;
    margin: 0;
}

.skills__sub {
    margin-top: 12px;
    padding: 0;
    font-size: 36px;
    letter-spacing: 6px;
    -unity-text-align: middle-center;
    color: var(--hud-gold);
}

/* Chest upgrade screen (KAN-73): same cards, warm gold band and title ("RELIQUARY"); Rare chest = soul blue band. */
.skills--chest {
    background-color: rgba(14, 9, 3, 0.6);
}

.skills--chest .skills__band {
    background-color: rgba(26, 16, 4, 0.86);
    border-color: rgba(255, 196, 80, 0.85);
}

.skills--chest .skills__title {
    font-size: 92px;
    color: rgb(255, 214, 120);
    -unity-text-outline-color: rgba(96, 52, 6, 0.95);
}

.skills--chest .skills__sub {
    color: rgb(250, 238, 210);
}

.skills--chest-rare .skills__band {
    background-color: rgba(6, 14, 30, 0.88);
    border-color: rgba(120, 180, 255, 0.9);
}

.skills--chest-rare .skills__title {
    color: rgb(170, 210, 255);
    -unity-text-outline-color: rgba(14, 40, 90, 0.95);
}

/* Never squashed: the cards are as tall as their longest text (KAN-76). */
.skills__cards {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
}

/* min-height, not height (KAN-76): a 2-line name + 3-line text grows the card instead of running into the pips;
   the row stretches the other cards of the offer to the same height. */
.unity-button.skill-card {
    width: 316px;
    min-height: 560px;
    margin: 0 9px;
    padding: 22px 16px 22px 16px;
    flex-direction: column;
    align-items: center;
    border-radius: 18px;
    border-width: 4px;
    border-color: var(--card-rim);
    border-top-width: 10px;
    background-color: rgba(22, 20, 24, 0.96);
    transition-property: background-color;
    transition-duration: 0.08s;
}

.unity-button.skill-card:hover {
    background-color: rgba(30, 28, 32, 0.96);
}

.unity-button.skill-card:active {
    background-color: rgba(48, 40, 30, 0.98);
}

/* Re-roll (KAN-67): rounded stone button under the cards, gold rim, white die with 3 pips, count in soul blue.
   Disabled (0 left / no other skill) = dimmed, no rim glow. 96 px tall = well above the 48 dp touch minimum. */
.skills__actions {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: center;
    margin-top: 44px;
}

.unity-button.skills__reroll {
    flex-direction: row;
    align-items: center;
    height: 104px;
    min-width: 400px;
    margin: 0;
    padding: 0 40px 0 28px;
    border-radius: 52px;
    border-width: 3px;
    border-color: rgba(232, 196, 120, 0.85);
    background-color: rgba(26, 22, 20, 0.94);
    background-image: none;
    transition-property: background-color, scale;
    transition-duration: 0.08s;
}

.unity-button.skills__reroll:hover {
    background-color: rgba(36, 30, 26, 0.96);
}

.unity-button.skills__reroll:active {
    background-color: rgba(60, 46, 30, 0.98);
    scale: 0.96 0.96;
}

.unity-button.skills__reroll:disabled {
    opacity: 0.42;
    border-color: rgba(150, 146, 138, 0.5);
}

.skills__die {
    width: 52px;
    height: 52px;
    margin-right: 20px;
    border-radius: 12px;
    background-color: rgb(236, 228, 210);
    border-width: 2px;
    border-color: rgb(120, 96, 60);
    rotate: -12deg;
}

.skills__die-pip {
    position: absolute;
    width: 11px;
    height: 11px;
    border-radius: 6px;
    background-color: rgb(110, 22, 18);
}

.skills__die-pip--a { left: 7px; top: 7px; }
.skills__die-pip--b { left: 18px; top: 18px; }
.skills__die-pip--c { left: 29px; top: 29px; }

.skills__reroll-text {
    font-size: 40px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    color: rgb(255, 228, 170);
    padding: 0;
    margin: 0;
}

.skills__reroll-count {
    margin-left: 18px;
    padding: 0;
    font-size: 40px;
    -unity-font-style: bold;
    color: var(--hud-soul-glow);
}

/* Single-class rules so the rarity classes below (same specificity, later) override the defaults. */
.skill-card { --card-rim: rgb(150, 146, 138); --card-glow: rgb(222, 216, 204); }
.skill-card--common { --card-rim: rgb(150, 146, 138); --card-glow: rgb(222, 216, 204); }
.skill-card--rare { --card-rim: rgb(86, 150, 236); --card-glow: rgb(170, 214, 255); }
.skill-card--epic { --card-rim: rgb(166, 96, 236); --card-glow: rgb(222, 186, 255); }
.skill-card--legendary { --card-rim: rgb(244, 172, 48); --card-glow: rgb(255, 224, 140); }

.unity-button.skill-card--rare {
    background-color: rgba(14, 22, 36, 0.96);
}

.unity-button.skill-card--epic {
    background-color: rgba(28, 16, 40, 0.96);
}

.unity-button.skill-card--legendary {
    background-color: rgba(40, 24, 8, 0.96);
    border-width: 6px;
    border-top-width: 12px;
    border-bottom-width: 12px;
}

/* Legendary light sweep: the clip box fills the card, the band moves across it in code (translate). */
.skill-card__sheen {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    overflow: hidden;
    border-radius: 12px;
    display: none;
}

.skill-card--legendary .skill-card__sheen {
    display: flex;
}

.skill-card__shine {
    position: absolute;
    top: -120px;
    bottom: -120px;
    left: 0;
    width: 84px;
    rotate: 18deg;
    background-color: rgba(255, 236, 180, 0.22);
    border-left-width: 10px;
    border-right-width: 10px;
    border-color: rgba(255, 236, 180, 0.1);
}

.skill-card__marks {
    flex-direction: row;
    justify-content: center;
    height: 20px;
    margin: -6px 0 12px 0;
}

.skill-mark {
    width: 13px;
    height: 13px;
    margin: 3px 6px;
    rotate: 45deg;
    background-color: var(--card-rim);
    border-width: 1px;
    border-color: var(--card-glow);
}

/* Ring + sparks out of the icon plate when a burst tier lands. Scale / opacity / translate set in code. */
.skill-card__burst {
    position: absolute;
    left: -4px; right: -4px; top: -4px; bottom: -4px;
    border-radius: 102px;
    border-width: 8px;
    border-color: var(--card-glow);
    opacity: 0;
}

.skill-spark {
    position: absolute;
    left: 89px;
    top: 89px;
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: var(--card-glow);
    opacity: 0;
}

.skill-card__rarity {
    font-size: 26px;
    letter-spacing: 5px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--card-glow);
    margin: 0 0 14px 0;
    padding: 0;
}

.skill-card__plate {
    width: 196px;
    height: 196px;
    border-radius: 98px;
    border-width: 4px;
    border-color: var(--card-rim);
    background-color: rgba(6, 6, 8, 0.85);
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
}

.skill-card__icon {
    width: 150px;
    height: 150px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--card-glow);
}

/* Slot-machine roll (KAN-159): while a card rolls, its plate clips the two moving icons (current + next skill, moved in
   code), the rim stays neutral (no tier class) and tier, gems, text, pips and badge wait for the stop. visibility keeps
   the layout, so the card does not change size when they appear. */
.skill-card__reel {
    position: absolute;
    left: 19px;
    top: 19px;
    display: none;
}

.skill-card--rolling .skill-card__reel {
    display: flex;
}

.skill-card--rolling .skill-card__plate {
    overflow: hidden;
}

.skill-card--rolling .skill-card__rarity,
.skill-card--rolling .skill-card__marks,
.skill-card--rolling .skill-card__desc,
.skill-card--rolling .skill-card__pips,
.skill-card--rolling .skill-card__badge {
    visibility: hidden;
}

/* The real name keeps its place (and the card height) but is see-through; the reel name (absolute in the card, top set
   in code to the name's slot) runs over it on one line. */
.skill-card--rolling .skill-card__name {
    color: rgba(0, 0, 0, 0);
    -unity-text-outline-color: rgba(0, 0, 0, 0);
}

.skill-card__reel-name {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    display: none;
    overflow: hidden;
    text-overflow: clip;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    color: rgb(255, 236, 196);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
    margin: 0;
    padding: 0;
}

.skill-card--rolling .skill-card__reel-name {
    display: flex;
}

.skill-card__name {
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(255, 236, 196);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
    margin: 0 0 12px 0;
    padding: 0;
}

/* Card parts keep their own height (KAN-76): the default flex-shrink squashed the name / text box and the last line
   was drawn over the pips. The spacer between text and pips is the only part that gives. */
.skill-card__rarity,
.skill-card__marks,
.skill-card__plate,
.skill-card__name,
.skill-card__desc,
.skill-card__pips {
    flex-shrink: 0;
}

.skill-card__desc {
    font-size: 30px;
    -unity-text-align: upper-center;
    white-space: normal;
    color: rgb(206, 200, 188);
    margin: 0 0 16px 0;
    padding: 0 4px;
}

.skill-card__pips {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 12px;
}

.skill-pip {
    width: 30px;
    height: 12px;
    margin: 0 4px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.12);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.6);
}

.skill-pip--on {
    background-color: var(--card-rim);
}

.skill-pip--next {
    background-color: var(--card-glow);
    border-color: rgb(255, 255, 255);
}

.skill-card__badge {
    position: absolute;
    top: -26px;
    right: 14px;
    padding: 4px 14px;
    border-radius: 8px;
    font-size: 24px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: rgb(30, 18, 8);
    background-color: var(--hud-gold);
}

/* Upgrade of an owned skill (KAN-50): "LV N → N+1", dark plate + gold text, so NEW stays the louder badge. */
.skill-card__badge--up {
    letter-spacing: 1px;
    color: var(--hud-gold);
    background-color: rgba(14, 10, 6, 0.92);
    border-width: 2px;
    border-color: var(--hud-gold);
}

/* Owned skills row (SkillHud, KAN-19): under the health bar, left aligned. */
.hud-skills {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 14px 40px 0 40px;
}

.hud-skill {
    width: 76px;
    height: 76px;
    margin: 0 10px 28px 0;
    border-radius: 38px;
    border-width: 3px;
    border-color: var(--slot-rim);
    background-color: rgba(8, 8, 10, 0.72);
    align-items: center;
    justify-content: center;
    --slot-rim: rgb(150, 146, 138);
    --slot-glow: rgb(222, 216, 204);
}

/* Tier shape (KAN-37), a second cue next to colour: circle, rounded square, square, square with a heavy rim. */
.hud-skill--rare { --slot-rim: rgb(86, 150, 236); --slot-glow: rgb(170, 214, 255); border-radius: 24px; }
.hud-skill--epic { --slot-rim: rgb(166, 96, 236); --slot-glow: rgb(222, 186, 255); border-radius: 12px; }
.hud-skill--legendary { --slot-rim: rgb(244, 172, 48); --slot-glow: rgb(255, 224, 140); border-radius: 6px; border-width: 5px; }

.hud-skill__icon {
    width: 56px;
    height: 56px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--slot-glow);
}

/* Level pips under each slot (KAN-74): one per level up to the skill's max, lit in the tier rim colour, glow colour at
   max level. Absolute under the rim so the icon keeps its size; .hud-skill margin-bottom leaves room for them. */
.hud-skill__pips {
    position: absolute;
    left: -3px;
    right: -3px;
    bottom: -22px;
    flex-direction: row;
    justify-content: center;
}

/* Empty pip is dark (not translucent white): on snow a pale empty pip read like a lit Common one. */
.hud-skill__pip {
    width: 10px;
    height: 8px;
    margin: 0 1px;
    border-radius: 2px;
    background-color: rgba(14, 12, 10, 0.8);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.9);
}

.hud-skill__pip--on {
    background-color: var(--slot-rim);
}

.hud-skill--max .hud-skill__pip--on {
    background-color: var(--slot-glow);
}

/* Pips the last level-up added, blinking during the glow. */
.hud-skill__pip--new {
    background-color: rgb(255, 255, 255);
    border-color: var(--slot-glow);
}

/* Level-up glow ring (KAN-74): tier glow colour, outside the rim; opacity and scale set in code. Radius = slot radius + 10. */
.hud-skill__glow {
    position: absolute;
    left: -13px;
    top: -13px;
    right: -13px;
    bottom: -13px;
    border-width: 5px;
    border-color: var(--slot-glow);
    border-radius: 51px;
    background-color: rgba(255, 236, 196, 0.08);
}

.hud-skill--rare .hud-skill__glow { border-radius: 37px; }
.hud-skill--epic .hud-skill__glow { border-radius: 25px; }
.hud-skill--legendary .hud-skill__glow { border-radius: 19px; left: -15px; top: -15px; right: -15px; bottom: -15px; }

/* Crit and fire damage numbers (CombatHud, KAN-19). */
.combat-number--crit {
    color: rgb(255, 214, 92);
    font-size: 60px;
}

.combat-number--burn {
    color: rgb(255, 150, 60);
    font-size: 36px;
}

.combat-number--burst {
    color: rgb(190, 226, 255);
    font-size: 42px;
}

/* Ember Shards from a Rare chest (KAN-97): wide ember-red label over the chest. */
.combat-number--gems {
    width: 400px;
    margin-left: -200px;
    color: rgb(255, 120, 84);
    font-size: 50px;
}

/* Chamber survival countdown (TimerHud, KAN-39): pill under the XP bar. Scale set in code during the final pulse. */
.hud-timer {
    align-self: center;
    margin-top: 12px;
    padding: 0 30px;
    border-radius: 34px;
    border-width: 2px;
    border-color: rgba(232, 196, 120, 0.4);
    background-color: rgba(8, 10, 16, 0.62);
}

.hud-timer__label {
    margin: 0;
    padding: 2px 0;
    font-size: 54px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(246, 236, 212);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
}

.hud-timer--final {
    border-color: rgb(226, 64, 40);
    background-color: rgba(76, 10, 4, 0.72);
}

.hud-timer--final > .hud-timer__label {
    color: rgb(255, 128, 100);
}

.hud-timer--done {
    border-color: var(--hud-soul);
}

.hud-timer--done > .hud-timer__label {
    color: var(--hud-soul-glow);
}

/* Timer toasts (TimerHud). Gold for warnings, soul blue and bigger when the portal opens. */
.chamber-toast {
    position: absolute;
    left: 0;
    right: 0;
    top: 360px;
    margin: 0;
    padding: 0;
    font-size: 54px;
    letter-spacing: 5px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--hud-gold);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgba(20, 10, 0, 0.9);
}

.chamber-toast--open {
    font-size: 66px;
    letter-spacing: 3px;
    color: var(--hud-soul-glow);
    -unity-text-outline-color: rgba(10, 30, 60, 0.95);
}

/* Portal transition (ChamberTransitionHud, KAN-40). White-blue fade over everything; title card in the upper third. */
.transition-fade {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgb(236, 244, 255);
    opacity: 0;
}

.chamber-card {
    position: absolute;
    left: 0;
    right: 0;
    top: 520px;
    padding: 40px 0 44px 0;
    align-items: center;
    background-color: rgba(8, 12, 22, 0.62);
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-color: rgba(156, 210, 255, 0.55);
    opacity: 0;
}

.chamber-card__title {
    font-size: 104px;
    letter-spacing: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--hud-gold);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgba(20, 10, 0, 0.9);
    padding: 0;
    margin: 0;
}

.chamber-card__rule {
    width: 420px;
    height: 3px;
    margin: 14px 0 12px 0;
    background-color: var(--hud-soul);
}

.chamber-card__sub {
    font-size: 40px;
    letter-spacing: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--hud-soul-glow);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(10, 30, 60, 0.95);
    padding: 0;
    margin: 0;
}

/* Boss banner (BossBannerHud, KAN-62). A dark smoky band across the lower middle: boss name in pale gold during the
   intro, "GREAT FOE FELLED" in bright gold after the kill. Fade and the slow text swell are set in code. */
.boss-banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 1060px;
    padding: 34px 0 38px 0;
    align-items: center;
    background-color: rgba(6, 4, 4, 0.66);
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-color: rgba(232, 196, 120, 0.28);
    opacity: 0;
}

.boss-banner__text {
    font-size: 62px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(240, 222, 180);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgba(20, 8, 0, 0.92);
    padding: 0;
    margin: 0;
}

.boss-banner__rule {
    width: 460px;
    height: 3px;
    margin: 12px 0 10px 0;
    background-color: rgb(150, 30, 22);
}

.boss-banner__sub {
    font-size: 34px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--hud-ash);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
    padding: 0;
    margin: 0;
}

.boss-banner--victory {
    border-color: rgba(232, 196, 120, 0.55);
}

.boss-banner--victory > .boss-banner__text {
    font-size: 76px;
    letter-spacing: 5px;
    color: rgb(255, 214, 120);
    -unity-text-outline-color: rgba(40, 18, 0, 0.95);
}

.boss-banner--victory > .boss-banner__rule {
    background-color: var(--hud-gold);
}

.boss-banner--victory > .boss-banner__sub {
    color: var(--hud-soul-glow);
    -unity-text-outline-color: rgba(10, 30, 60, 0.95);
}

/* Boss health bar (BossHud, KAN-58). Wide crimson bar under the XP bar (the timer's place: boss Chambers have none).
   Name above in gold, title below in ash. Slides down and fades in when the boss rises (BossHud animates translate/opacity). */
.hud-boss {
    align-self: center;
    width: 88%;
    margin-top: 10px;
    align-items: center;
}

.hud-boss__name {
    margin: 0;
    padding: 0;
    font-size: 44px;
    letter-spacing: 5px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--hud-gold);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
}

.hud-boss__track {
    width: 100%;
    height: 30px;
    margin-top: 6px;
    background-color: rgba(8, 6, 6, 0.8);
    border-width: 3px;
    border-color: rgba(232, 196, 120, 0.55);
    border-radius: 4px;
    overflow: hidden;
}

.hud-boss__trail,
.hud-boss__fill {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 100%;
}

.hud-boss__trail {
    background-color: rgb(236, 196, 104);
}

.hud-boss__fill {
    background-color: rgb(168, 26, 20);
    border-right-width: 2px;
    border-color: rgba(255, 150, 120, 0.6);
}

/* Phase 2 (KAN-61): a dark-edged gold tick at the phase 2 share (BossHud sets left), lit once phase 2 starts; the bar
   turns a hotter red ("enraged"). */
.hud-boss__phase {
    position: absolute;
    top: 0; bottom: 0;
    width: 6px;
    margin-left: -3px;
    background-color: rgba(236, 196, 104, 0.55);
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: rgba(0, 0, 0, 0.85);
}

.hud-boss__phase--lit {
    background-color: rgb(255, 228, 150);
}

.hud-boss--enraged .hud-boss__fill {
    background-color: rgb(212, 52, 20);
}

.hud-boss--enraged .hud-boss__track {
    border-color: rgba(255, 160, 90, 0.85);
}

.hud-boss__title {
    margin: 4px 0 0 0;
    padding: 0;
    font-size: 28px;
    letter-spacing: 2px;
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    color: rgb(226, 220, 208);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
}

/* End of Realm victory screen (RealmVictoryHud, KAN-47). Same frame as the death screen, gold instead of red: dark veil
   over the paused world, gold-ruled band with "REALM CLEARED" + Realm name, counters, unlock line, CONTINUE. */
.victory {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    justify-content: center;
    align-items: stretch;
    background-color: rgba(4, 6, 12, 0.8);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.9s;
    transition-timing-function: ease-out-sine;
}

.victory--shown {
    opacity: 1;
}

.victory__band {
    padding: 64px 0 56px 0;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.74);
    border-top-width: 3px;
    border-color: var(--hud-gold);
}

.victory__title {
    font-size: 96px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--hud-gold);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(30, 16, 0, 0.95);
    padding: 0;
    margin: 0;
}

.victory__rule {
    width: 520px;
    height: 3px;
    margin: 18px 0 16px 0;
    background-color: rgba(232, 196, 120, 0.6);
}

.victory__realm {
    font-size: 40px;
    letter-spacing: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(236, 228, 210);
    padding: 0;
    margin: 0;
}

.victory__stats {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 30px 0 34px 0;
    background-color: rgba(0, 0, 0, 0.6);
    border-top-width: 1px;
    border-bottom-width: 3px;
    border-color: rgba(232, 196, 120, 0.35);
}

.victory__unlock {
    margin-top: 44px;
    padding: 18px 40px;
    align-self: center;
    font-size: 38px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(206, 198, 182);
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 6px;
}

.victory__unlock--new {
    color: var(--hud-soul-glow);
    border-width: 2px;
    border-color: rgba(156, 210, 255, 0.55);
}

.unity-button.victory__button {
    width: 460px;
}

/* Test Mode tag (KAN-144): bottom left, small, cold blue (never reads as a reward). */
.hud-test-tag {
    position: absolute;
    left: 40px;
    bottom: 40px;
    padding: 6px 14px;
    font-size: 24px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    color: rgb(150, 210, 255);
    background-color: rgba(10, 22, 36, 0.75);
    border-width: 2px;
    border-color: rgba(120, 200, 255, 0.55);
    border-radius: 6px;
}

/* ------------------------------------------------------------ Gate arrow (GateArrowHud, KAN-63) */
/* Placed in code: width / height = size, translate = edge point, rotate = toward the gate, scale = pulse. The sprite is
   the Blender arrow baked tip-up (T_UI_GateArrow.png, ember glow included). */
.gate-arrow {
    position: absolute;
    left: 0; top: 0;
    width: 150px;
    height: 150px;
}

.gate-arrow__icon {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* Two small arrows behind the tail (local "down" = away from the gate); opacity animated in code. */
.gate-arrow__trail {
    position: absolute;
    left: 27%; width: 46%;
    top: 84%; height: 46%;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0;
}

.gate-arrow__trail--far {
    top: 118%;
    left: 32%; width: 36%;
    height: 36%;
}

.gate-arrow__dist {
    position: absolute;
    left: 0; top: 0;
    width: 120px;
    height: 36px;
    margin: 0;
    padding: 0;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(250, 222, 160);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
}
