/* In-game HUD. Reference 1080x1920, match width (see GameHudPanelSettings). Sizes in px. */

:root {
    --hud-gold: rgb(232, 196, 120);
    --hud-ash: rgba(206, 200, 188, 0.75);
    --hud-ring: rgba(232, 196, 120, 0.35);
    --hud-ring-fill: rgba(10, 12, 18, 0.28);
    --hud-knob: rgba(232, 196, 120, 0.55);
    --hud-chevron: rgba(244, 214, 150, 0.95);
    --hud-panel: rgba(16, 18, 26, 0.7);
    --hud-hp-fill: rgb(116, 178, 74);
    --hud-hp-trail: rgb(236, 196, 104);
    --hud-hp-track: rgba(8, 8, 10, 0.72);
    --hud-death-red: rgb(158, 24, 18);
}

.hud-hidden {
    display: none;
}

.hud-root {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    flex-direction: column;
}

.hud-top {
    flex-direction: row;
    align-items: center;
    padding: 36px 40px 0 40px;
}

.hud-spacer {
    flex-grow: 1;
}

.hud-button {
    width: 120px;
    height: 120px;
    border-radius: 60px;
    border-width: 3px;
    border-color: var(--hud-ring);
    background-color: var(--hud-panel);
    color: var(--hud-gold);
    font-size: 44px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.hud-button:active {
    background-color: rgba(60, 46, 28, 0.85);
}

.hud-hint {
    align-self: center;
    margin-bottom: 480px; /* above the idle joystick (JoystickView.idleBottomMargin + ring + chevron) */
    font-size: 40px;
    color: var(--hud-ash);
    -unity-text-align: middle-center;
    transition-property: opacity;
    transition-duration: 0.6s;
}

.hud-hint--gone {
    opacity: 0;
}

/* Joystick (JoystickView, KAN-16): size, translate and opacities set in code; these are the looks.
   Transparent on purpose: the stick sits over the world. Chevron = square with two borders, turned 45 deg. */
.hud-joystick {
    position: absolute;
    left: 0;
    top: 0;
    width: 240px;
    height: 240px;
}

.hud-joystick__ring {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    border-width: 3px;
    border-color: var(--hud-ring);
    background-color: var(--hud-ring-fill);
    border-radius: 120px;
}

.hud-joystick__side {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

.hud-joystick__side--right { rotate: 90deg; }
.hud-joystick__side--down { rotate: 180deg; }
.hud-joystick__side--left { rotate: 270deg; }

.hud-joystick__chevron {
    position: absolute;
    left: 50%;
    top: -20%; /* just outside the ring: the knob at full drag never hides the active chevron */
    width: 46px;
    height: 46px;
    margin-left: -23px;
    border-top-width: 8px;
    border-left-width: 8px;
    border-color: var(--hud-chevron);
    border-top-left-radius: 4px;
    rotate: 45deg;
}

.hud-joystick__knob {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 72px;
    height: 72px;
    margin-left: -36px;
    margin-top: -36px;
    border-radius: 36px;
    background-color: var(--hud-knob);
    border-width: 2px;
    border-color: rgba(255, 236, 190, 0.7);
    opacity: 0;
}

/* Combat (CombatHud): placed in code with translate at a world point; margins centre each element on it. */
.combat-layer {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    overflow: hidden;
}

.combat-bar {
    position: absolute;
    left: 0; top: 0;
    width: 96px;
    height: 8px;
    margin-left: -48px;
    margin-top: -4px;
    background-color: rgba(8, 6, 6, 0.7);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.9);
    border-radius: 2px;
    overflow: hidden;
}

.combat-bar__fill {
    height: 100%;
    width: 100%;
    background-color: rgb(196, 38, 34);
}

.combat-number {
    position: absolute;
    left: 0; top: 0;
    width: 200px;
    height: 60px;
    margin-left: -100px;
    margin-top: -30px;
    padding: 0;
    font-size: 46px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 236, 190);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
}

.combat-number--kill {
    color: rgb(255, 92, 72);
    font-size: 54px;
}

/* Hit / kill marker (HitMarkerHud, KAN-13). Zero-size marker placed with translate; arms rotated in code
   (45/135/225/315 deg) about their own point; each tick sits above its arm, past the centre gap.
   Gap = -top - height. Dark border keeps white ticks readable on pale sand plazas. */
.hit-marker-layer {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    overflow: hidden;
}

.hit-marker {
    position: absolute;
    left: 0; top: 0;
    width: 0;
    height: 0;
}

.hit-marker__arm {
    position: absolute;
    left: 0; top: 0;
    width: 0;
    height: 0;
}

.hit-marker__tick {
    position: absolute;
    width: 9px;
    height: 30px;
    left: -4.5px;
    top: -54px; /* gap 24 px */
    border-radius: 3px;
    border-width: 1.5px;
    border-color: rgba(0, 0, 0, 0.55);
    background-color: rgb(255, 255, 255);
}

.hit-marker--kill .hit-marker__tick {
    width: 12px;
    height: 42px;
    left: -6px;
    top: -72px; /* gap 30 px */
    border-color: rgba(30, 0, 0, 0.6);
    background-color: rgb(236, 44, 34);
}

/* Player health (PlayerHealthHud). Fill/trail widths set in code (percent). Green = the player; red = enemies. */
.hud-hp {
    flex-grow: 1;
    max-width: 640px;
    margin-left: 32px;
    flex-direction: row;
    align-items: center;
}

.hud-hp__track {
    flex-grow: 1;
    height: 34px;
    background-color: var(--hud-hp-track);
    border-width: 3px;
    border-color: rgba(232, 196, 120, 0.45);
    border-radius: 4px;
    overflow: hidden;
}

.hud-hp__trail,
.hud-hp__fill {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 100%;
}

.hud-hp__trail {
    background-color: var(--hud-hp-trail);
}

.hud-hp__fill {
    background-color: var(--hud-hp-fill);
    border-right-width: 2px;
    border-color: rgba(220, 255, 190, 0.5);
}

.hud-hp__value {
    min-width: 110px;
    margin-left: 16px;
    padding: 0;
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: var(--hud-gold);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
}

.hud-overhead {
    position: absolute;
    left: 0; top: 0;
    width: 120px;
    height: 12px;
    margin-left: -60px;
    margin-top: -6px;
    background-color: var(--hud-hp-track);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.9);
    border-radius: 3px;
    overflow: hidden;
}

.hud-overhead__fill {
    height: 100%;
    width: 100%;
    background-color: var(--hud-hp-fill);
}

/* Damage vignette: full-screen generated texture, stretched (ellipse follows the screen shape). */
.hud-vignette {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    opacity: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

/* Death screen (Souls style): dark veil, black band, big red title, two buttons. */
.death {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    justify-content: center;
    align-items: stretch;
    background-color: rgba(0, 0, 0, 0.45);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 1.2s;
    transition-timing-function: ease-in-sine;
}

.death--shown {
    opacity: 1;
}

.death__band {
    padding: 70px 0;
    background-color: rgba(0, 0, 0, 0.72);
    align-items: center;
}

.death__title {
    font-size: 132px;
    letter-spacing: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--hud-death-red);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(30, 0, 0, 0.9);
    padding: 0;
    margin: 0;
}

.death__buttons {
    flex-direction: row;
    justify-content: center;
    margin-top: 110px;
}

.unity-button.death__button {
    width: 340px;
    height: 132px;
    margin: 0 22px;
    padding: 0;
    font-size: 46px;
    letter-spacing: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(206, 200, 188);
    background-color: rgba(20, 22, 30, 0.85);
    background-image: none;
    border-width: 2px;
    border-color: rgba(232, 196, 120, 0.3);
    border-radius: 4px;
}

.unity-button.death__button--primary {
    color: rgb(255, 228, 170);
    background-color: rgba(150, 70, 28, 0.88);
    border-color: var(--hud-gold);
}

.unity-button.death__button:active {
    scale: 0.97 0.97;
}
