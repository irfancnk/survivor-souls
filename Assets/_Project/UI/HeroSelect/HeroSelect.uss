/* Hero page (KAN-153, KAN-244). Same palette as MainMenu.uss (its :root variables, .ss-button, .ss-wallet and .ss-hidden
   apply here too: this tree is instanced inside MainMenu.uxml). Reference 1080x1920 portrait, match width.
   The 3D hero stage (HeroStage render texture) fills hs-stage; the hero stands in the middle band (about 14 % to 66 % of
   the height); his text sits under him with no boxes: soft shadows carry the contrast.
   Open / close: HeroSelectScreen toggles hs-screen--closed; the transition fades and slides (like Store.uss). */

.hs-screen {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgb(9, 11, 17); /* opaque: the menu title must not show through */
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-cubic;
}

.hs-screen--closed {
    opacity: 0;
    translate: 0 60px;
}

/* ---------- Stage ---------- */

.hs-stage {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.hs-shade {
    position: absolute;
    left: 0;
    right: 0;
    background-image: url("project://database/Assets/_Project/Art/Textures/T_FadeV.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(6, 8, 12);
}

.hs-shade--top {
    top: 0;
    height: 18%;
    rotate: 180deg; /* the texture is opaque at the bottom; flip it for the top edge */
    opacity: 0.8;
}

.hs-shade--bottom {
    bottom: 0;
    height: 44%;
    opacity: 0.92;
}

.hs-safe {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    flex-direction: column;
    align-items: center;
}

/* ---------- Header ---------- */

.hs-header {
    width: 940px;
    margin-top: 56px;
    flex-direction: column;
    align-items: center;
}

.hs-header__bar {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.unity-button.hs-back {
    height: 96px;
    min-width: 220px;
    margin: 0;
    padding: 0 30px;
    font-size: 34px;
    letter-spacing: 8px;
    -unity-font-style: bold;
    color: var(--ss-ash);
    background-color: rgba(20, 22, 30, 0.55);
    background-image: none;
    border-width: 2px;
    border-color: rgba(232, 196, 120, 0.22);
    border-radius: 4px;
}

.unity-button.hs-back:active {
    scale: 0.96 0.96;
}

.hs-pills {
    flex-direction: column;
    align-items: flex-end;
}

.hs-pill {
    scale: 1 1;
    transition-property: scale;
    transition-duration: 0.14s;
}

.hs-pill--pop {
    scale: 1.12 1.12;
}

.hs-title {
    position: absolute;
    top: 18px;
    left: 0;
    right: 0;
    font-size: 40px;
    letter-spacing: 16px;
    padding-left: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgba(232, 196, 120, 0.75);
    margin: 0;
    text-shadow: 0 3px 10px rgba(0, 0, 0, 0.9);
}

.hs-test-note {
    margin-top: 10px;
    padding: 6px 18px;
    font-size: 26px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    color: rgb(255, 214, 120);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9);
}

/* ---------- Arrows (the hero swap; a swipe from the edges does the same) ---------- */

.unity-button.hs-arrow {
    position: absolute;
    top: 36%;
    width: 120px;
    height: 200px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-width: 0;
    align-items: center;
    justify-content: center;
    opacity: 0.75;
    transition-property: opacity, scale;
    transition-duration: 0.12s;
}

.unity-button.hs-arrow:hover {
    opacity: 1;
}

.unity-button.hs-arrow:active {
    scale: 0.9 0.9;
}

.hs-arrow--prev {
    left: 6px;
}

.hs-arrow--next {
    right: 6px;
}

/* An L of two borders turned 45 deg: a thin chevron, no glyph needed. */
.hs-arrow__chevron {
    width: 44px;
    height: 44px;
    border-left-width: 5px;
    border-bottom-width: 5px;
    border-color: var(--ss-gold);
    rotate: 45deg;
    translate: 10px 0;
}

.hs-arrow--next .hs-arrow__chevron {
    rotate: -135deg;
    translate: -10px 0;
}

/* ---------- Hero text ---------- */

.hs-info {
    position: absolute;
    top: 66%;
    left: 60px;
    right: 60px;
    flex-direction: column;
    align-items: center;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.28s;
    transition-timing-function: ease-out-cubic;
}

.hs-info--snap {
    transition-duration: 0s;
}

.hs-info--out-left {
    opacity: 0;
    translate: -70px 0;
}

.hs-info--out-right {
    opacity: 0;
    translate: 70px 0;
}

.hs-dots {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 18px;
}

.hs-dot {
    width: 14px;
    height: 14px;
    margin: 0 10px;
    rotate: 45deg;
    border-radius: 2px;
    background-color: rgba(206, 200, 188, 0.3);
}

.hs-dot--on {
    background-color: var(--ss-gold-bright);
}

.hs-badge {
    font-size: 24px;
    letter-spacing: 8px;
    padding-left: 8px;
    -unity-font-style: bold;
    color: var(--ss-gold-bright);
    margin: 0 0 4px 0;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9);
}

.hs-name {
    font-size: 76px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--ss-gold);
    margin: 0;
    white-space: normal;
    text-shadow: 0 5px 16px rgba(0, 0, 0, 0.95);
}

.hs-tagline {
    margin-top: 2px;
    font-size: 32px;
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    color: rgba(226, 220, 206, 0.78);
    white-space: normal;
    text-shadow: 0 3px 10px rgba(0, 0, 0, 0.95);
}

.hs-traits {
    margin-top: 26px;
    flex-direction: row;
    justify-content: center;
}

.hs-traits__col {
    flex-direction: column;
    align-items: flex-end;
    margin: 0 28px;
}

.hs-traits__col--cons {
    align-items: flex-start;
}

.hs-trait {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.hs-traits__col .hs-trait {
    flex-direction: row-reverse; /* strengths: text, then the mark towards the middle */
}

.hs-traits__col--cons .hs-trait {
    flex-direction: row;
}

/* Up / down chevron: two borders of a turned square. */
.hs-trait__mark {
    width: 13px;
    height: 13px;
    margin: 0 14px;
    rotate: 45deg;
}

.hs-trait__text {
    font-size: 32px;
    -unity-font-style: bold;
    margin: 0;
    text-shadow: 0 3px 10px rgba(0, 0, 0, 0.95);
}

.hs-trait--pro .hs-trait__mark {
    border-left-width: 4px;
    border-top-width: 4px;
    border-color: rgb(120, 210, 130);
    translate: 0 4px;
}

.hs-trait--pro .hs-trait__text {
    color: rgb(150, 226, 156);
}

.hs-trait--con .hs-trait__mark {
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-color: rgb(226, 96, 84);
    translate: 0 -4px;
}

.hs-trait--con .hs-trait__text {
    color: rgb(240, 140, 128);
}

/* Action row: price + one button. */
.hs-action-row {
    margin-top: 30px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.hs-price {
    flex-direction: row;
    align-items: center;
    margin-right: 30px;
}

.hs-price__gem {
    width: 24px;
    height: 24px;
    rotate: 45deg;
    margin-right: 14px;
    border-radius: 4px;
    border-width: 2px;
    border-color: rgb(255, 214, 170);
    background-color: rgb(232, 84, 52);
}

.hs-price__gem--souls {
    border-color: rgb(200, 230, 255);
    background-color: rgb(110, 170, 230);
    border-radius: 12px;
}

.hs-price__value {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(255, 222, 196);
    margin: 0;
    text-shadow: 0 3px 10px rgba(0, 0, 0, 0.95);
}

.hs-price--free .hs-price__value {
    color: rgb(255, 214, 120);
}

/* Lock: shackle (round top border) over a small body. */
.hs-lock {
    width: 30px;
    height: 38px;
    margin-right: 16px;
    align-items: center;
}

.hs-lock__shackle {
    width: 20px;
    height: 16px;
    border-top-width: 4px;
    border-left-width: 4px;
    border-right-width: 4px;
    border-color: var(--ss-ash);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

.hs-lock__body {
    width: 30px;
    height: 22px;
    border-radius: 4px;
    background-color: var(--ss-ash);
}

.unity-button.hs-action {
    width: 520px;
    height: 104px;
    margin: 0;
    font-size: 34px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    color: rgb(30, 22, 10);
    background-color: var(--ss-gold);
    background-image: none;
    border-width: 0;
    border-radius: 6px;
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

.unity-button.hs-action:active {
    scale: 0.96 0.96;
}

.unity-button.hs-action--buy {
    background-color: var(--ss-ember);
    color: rgb(255, 240, 224);
}

.unity-button.hs-action--confirm {
    background-color: rgb(240, 140, 60);
    color: rgb(30, 14, 4);
}

.unity-button.hs-action--poor {
    background-color: rgba(70, 60, 56, 0.85);
    color: var(--ss-ash-dim);
}

.unity-button.hs-action--current {
    background-color: rgba(30, 40, 32, 0.7);
    border-width: 2px;
    border-color: rgba(150, 226, 156, 0.5);
    color: rgb(150, 226, 156);
}

.hs-toast {
    position: absolute;
    top: 58%;
    left: 70px;
    right: 70px;
    -unity-text-align: middle-center;
    white-space: normal;
    font-size: 36px;
    -unity-font-style: bold;
    color: var(--ss-gold-bright);
    background-color: var(--ss-panel-solid);
    border-width: 2px;
    border-color: var(--ss-line);
    border-radius: 6px;
    padding: 22px 26px;
}
