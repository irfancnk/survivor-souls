<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="RealmSelect" src="project://database/Assets/_Project/UI/RealmSelect/RealmSelect.uxml" />
    <ui:Template name="SoulTree" src="project://database/Assets/_Project/UI/SoulTree/SoulTree.uxml" />
    <ui:Template name="Store" src="project://database/Assets/_Project/UI/Store/Store.uxml" />
    <Style src="MainMenu.uss" />
    <!-- Portrait layout: title top, bonfire (3D) in the middle, actions at the bottom (thumb zone). -->
    <ui:VisualElement name="shade-top" class="ss-shade ss-shade--top" picking-mode="Ignore" />
    <ui:VisualElement name="shade-bottom" class="ss-shade ss-shade--bottom" picking-mode="Ignore" />

    <ui:VisualElement name="safe-root" class="ss-root" picking-mode="Ignore">
        <!-- Test Mode tag (KAN-144): top left while Test Mode is on, so screenshots are never taken for real play. -->
        <ui:Label name="lbl-test-mode" text="TEST MODE" class="ss-test-tag ss-hidden" picking-mode="Ignore" />
        <!-- Souls held (SoulWallet, KAN-96) and Ember Shards held (GemWallet, KAN-97): top right. Placeholder until the KAN-56 currency bar. -->
        <ui:VisualElement name="wallets" class="ss-wallets" picking-mode="Ignore">
            <ui:VisualElement name="wallet" class="ss-wallet" picking-mode="Ignore">
                <ui:VisualElement class="ss-wallet__gem" picking-mode="Ignore" />
                <ui:Label name="lbl-wallet-souls" text="0" class="ss-wallet__value" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="wallet-gems" class="ss-wallet ss-wallet--gems" picking-mode="Ignore">
                <ui:VisualElement class="ss-wallet__gem ss-wallet__gem--ember" picking-mode="Ignore" />
                <ui:Label name="lbl-wallet-gems" text="0" class="ss-wallet__value ss-wallet__value--gems" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="ss-title-block" picking-mode="Ignore">
            <ui:Label text="SURVIVOR" class="ss-title ss-title--top" />
            <ui:Label text="SOULS" class="ss-title ss-title--bottom" />
            <ui:VisualElement class="ss-divider" />
            <ui:Label text="Kindle the flame. Outlast the dark." class="ss-tagline" />
        </ui:VisualElement>

        <ui:VisualElement class="ss-spacer" picking-mode="Ignore" />

        <ui:VisualElement class="ss-actions">
            <ui:Label name="lbl-toast" text="" class="ss-toast ss-hidden" picking-mode="Ignore" />
            <ui:Button name="btn-play" text="PLAY" class="ss-button ss-button--primary" />
            <ui:Button name="btn-soul-tree" text="SOUL TREE" class="ss-button" />
            <ui:Button name="btn-store" text="STORE" class="ss-button" />
            <ui:Button name="btn-settings" text="SETTINGS" class="ss-button" />
            <ui:Button name="btn-quit" text="QUIT" class="ss-button ss-button--muted" />
            <ui:Label name="lbl-version" text="v0.0.0" class="ss-version" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Realm selection page (KAN-20): full screen above the menu, hidden until PLAY. -->
    <ui:Instance template="RealmSelect" name="realm-select" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />

    <!-- Soul tree page (KAN-98): full screen above the menu, hidden until SOUL TREE. -->
    <ui:Instance template="SoulTree" name="soul-tree" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />

    <!-- Store page (KAN-99): full screen above the menu, hidden until STORE. -->
    <ui:Instance template="Store" name="store" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />

    <ui:VisualElement name="settings-overlay" class="ss-overlay ss-hidden">
        <ui:VisualElement class="ss-modal">
            <ui:Label name="lbl-settings-title" text="SETTINGS" class="ss-modal-title" />
            <ui:VisualElement class="ss-divider ss-divider--wide" />
            <ui:Slider name="sld-music" label="Music" low-value="0" high-value="1" class="ss-field" />
            <ui:Slider name="sld-sfx" label="Effects" low-value="0" high-value="1" class="ss-field" />
            <ui:Toggle name="tgl-vibration" label="Vibration" class="ss-field" />
            <ui:Toggle name="tgl-fps" label="60 FPS" class="ss-field" />
            <ui:Toggle name="tgl-reload-ring" label="Reload Ring" class="ss-field" />
            <!-- KAN-159: skill pick cards land at once, no slot-machine roll. -->
            <ui:Toggle name="tgl-fast-reveal" label="Fast Skill Reveal" class="ss-field" />
            <!-- KAN-82: no health bar shake / shards / flash, softer damage vignette, no low-health pulse. -->
            <ui:Toggle name="tgl-reduce-fx" label="Reduce Screen Effects" class="ss-field" />
            <!-- KAN-144: dev builds always; other builds after 7 taps on the title (TestModeReveal). -->
            <ui:Toggle name="tgl-test-mode" label="Test Mode" class="ss-field ss-field--test ss-hidden" />
            <!-- KAN-142: version + build (dev builds add the commit), so a bug report names its build. -->
            <ui:Label name="lbl-settings-version" text="v0.0.0" class="ss-version ss-version--settings" picking-mode="Ignore" />
            <ui:Button name="btn-settings-close" text="BACK" class="ss-button ss-button--primary ss-button--modal" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
