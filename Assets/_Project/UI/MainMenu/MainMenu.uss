/* Survivor Souls main menu. Palette: ember gold on deep slate, warm not grim.
   Portrait. Reference resolution 1080x1920, match width: tall phones (19.5:9) get extra
   height, which the flexible spacer absorbs. Keep sizes in px; PanelSettings scales. */

:root {
    --ss-gold: rgb(232, 196, 120);
    --ss-gold-bright: rgb(255, 222, 150);
    --ss-ember: rgb(214, 110, 46);
    --ss-ash: rgb(206, 200, 188);
    --ss-ash-dim: rgba(206, 200, 188, 0.6);
    --ss-panel-solid: rgba(16, 18, 26, 0.95);
    --ss-line: rgba(232, 196, 120, 0.45);
    --ss-shade: rgb(8, 10, 15);
}

.ss-hidden {
    display: none;
}

/* ---------- Full-screen shades (gradient texture, generated by MainMenuSceneBuilder) ---------- */

.ss-shade {
    position: absolute;
    left: 0;
    right: 0;
    background-image: url("project://database/Assets/_Project/Art/Textures/T_FadeV.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: var(--ss-shade);
}

.ss-shade--top {
    top: 0;
    height: 40%;
    rotate: 180deg; /* texture is opaque at the bottom; flip for the top edge */
    opacity: 0.85;
}

.ss-shade--bottom {
    bottom: 0;
    height: 52%;
}

/* ---------- Layout ---------- */

.ss-root {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    flex-direction: column;
    align-items: center;
}

.ss-title-block {
    margin-top: 150px;
    align-items: center;
}

.ss-spacer {
    flex-grow: 1;
}

.ss-actions {
    width: 780px;
    align-items: stretch;
    margin-bottom: 70px;
}

/* ---------- Title ---------- */

.ss-title {
    color: var(--ss-gold);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
    text-shadow: 0 6px 16px rgba(0, 0, 0, 0.85);
}

.ss-title--top {
    font-size: 76px;
    letter-spacing: 26px;
    color: var(--ss-ash);
    padding-left: 26px; /* balance trailing letter-spacing so text looks centred */
}

.ss-title--bottom {
    font-size: 176px;
    letter-spacing: 22px;
    margin-top: -22px;
    padding-left: 22px;
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: rgba(120, 60, 20, 0.9);
}

.ss-divider {
    height: 3px;
    width: 360px;
    margin-top: 22px;
    margin-bottom: 22px;
    background-color: var(--ss-ember);
}

.ss-divider--wide {
    width: 100%;
}

.ss-tagline {
    font-size: 36px;
    color: var(--ss-ash-dim);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    margin: 0;
    padding: 0;
}

/* ---------- Buttons ----------
   Selectors use .unity-button.ss-button so they beat the default runtime theme. */

.unity-button.ss-button {
    height: 132px; /* ~11 mm on a typical phone: comfortable thumb target */
    margin: 0 0 26px 0;
    padding: 0 36px;
    font-size: 46px;
    letter-spacing: 12px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: var(--ss-ash);
    background-color: rgba(20, 22, 30, 0.7);
    background-image: none;
    border-width: 2px;
    border-color: rgba(232, 196, 120, 0.22);
    border-radius: 4px;
    transition-property: background-color, border-color, color, scale;
    transition-duration: 0.12s;
}

.unity-button.ss-button:hover {
    color: var(--ss-gold-bright);
    border-color: var(--ss-gold);
}

.unity-button.ss-button:active {
    scale: 0.97 0.97;
    background-color: rgba(214, 110, 46, 0.3);
    border-color: var(--ss-ember);
}

.unity-button.ss-button--primary {
    color: var(--ss-gold-bright);
    background-color: rgba(150, 70, 28, 0.82);
    border-color: var(--ss-gold);
}

.unity-button.ss-button--muted {
    color: var(--ss-ash-dim);
    background-color: rgba(20, 22, 30, 0.5);
}

/* ---------- Footer + toast ---------- */

.ss-version {
    margin-top: 10px;
    font-size: 26px;
    color: var(--ss-ash-dim);
    letter-spacing: 3px;
    -unity-text-align: middle-center;
}

.ss-toast {
    margin-bottom: 26px;
    -unity-text-align: middle-center;
    white-space: normal;
    font-size: 34px;
    color: var(--ss-gold-bright);
    background-color: var(--ss-panel-solid);
    padding: 20px 28px;
    border-width: 1px;
    border-color: var(--ss-line);
}

/* ---------- Settings modal ---------- */

.ss-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.65);
    align-items: center;
    justify-content: center;
}

.ss-modal {
    width: 940px;
    padding: 56px 56px 36px 56px;
    background-color: var(--ss-panel-solid);
    border-width: 2px;
    border-color: var(--ss-line);
    border-radius: 4px;
}

.ss-modal-title {
    font-size: 64px;
    letter-spacing: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--ss-gold);
    margin: 0;
    padding: 0;
}

.ss-field {
    margin: 18px 0;
    min-height: 88px;
    align-items: center;
}

.ss-field > .unity-label {
    font-size: 40px;
    color: var(--ss-ash);
    min-width: 280px;
}

/* Slider internals: thicker track and larger thumb for touch. */
.ss-field .unity-base-slider__tracker {
    height: 10px;
    margin-top: -5px;
    background-color: rgba(206, 200, 188, 0.2);
    border-width: 0;
}

.ss-field .unity-base-slider__dragger {
    width: 52px;
    height: 52px;
    margin-top: -26px;
    border-radius: 26px;
    background-color: var(--ss-gold);
    border-width: 0;
}

.ss-field .unity-toggle__checkmark {
    width: 60px;
    height: 60px;
    background-color: rgba(206, 200, 188, 0.12);
    border-color: var(--ss-line);
    border-width: 2px;
    -unity-background-image-tint-color: var(--ss-gold);
}

.unity-button.ss-button--modal {
    margin-top: 36px;
    margin-bottom: 0;
}
